<?xml version="1.0" encoding="utf-8"?>
<!-- A few prints left on a table: one lying askew under another, the top one a ridge line.
     Photographs, more than one, the way they sit after someone has been looking through them.

     The ridge rather than the stock mountain-and-sun: the sun is a small circle, the first
     shape to smudge on sixteen greys, and the peaks are uneven because a real skyline is.
     The top print is filled white so it lies over the one beneath instead of tangling with it.

     Thin register, at the weights of Tuning Fork and Mesh: 108 viewport, stroke 3.0, round
     joins, no fill but white. Every point sits within 33 units of the centre, inside what the
     launcher's mask is certain to keep. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- the print underneath, turned the other way -->
    <group android:rotation="-8" android:pivotX="49" android:pivotY="46">
        <path
            android:strokeColor="#000000"
            android:strokeWidth="3.0"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M31.0,33.0 L67.0,33.0 L67.0,60.0 L31.0,60.0 Z" />
    </group>

    <!-- the print on top, with its ridge -->
    <group android:rotation="5" android:pivotX="59" android:pivotY="60">
        <path
            android:strokeColor="#000000"
            android:strokeWidth="3.0"
            android:strokeLineJoin="round"
            android:fillColor="#FFFFFF"
            android:pathData="M40.0,46.0 L78.0,46.0 L78.0,74.0 L40.0,74.0 Z" />
        <path
            android:strokeColor="#000000"
            android:strokeWidth="3.0"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M45.5,67.5 L53.0,57.0 L57.5,62.0 L65.0,52.0 L72.5,67.5" />
    </group>
</vector>
