<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Gallery</string>

    <!-- ============================================================ -->
    <!-- Folders: the first screen, every folder that holds a picture -->

    <!-- Cog button in the top bar, read aloud by a screen reader -->
    <string name="folders_cd_settings">Settings</string>
    <!-- Under a folder's name -->
    <plurals name="folders_count">
        <item quantity="one">%d picture</item>
        <item quantity="other">%d pictures</item>
    </plurals>
    <!-- Under a folder's name when it holds videos -->
    <plurals name="folders_videos">
        <item quantity="one">%d video</item>
        <item quantity="other">%d videos</item>
    </plurals>
    <!-- Both: %1$s is "3 pictures", %2$s is "2 videos" -->
    <string name="folders_both">%1$s, %2$s</string>
    <!-- Before the permission has been asked for -->
    <string name="folders_need_permission">To show your pictures, this needs Android\'s permission to read photos and media. It reads only the pictures.</string>
    <!-- Button (verb) -->
    <string name="folders_allow">Allow pictures</string>
    <!-- After the permission was refused and Android will not ask again -->
    <string name="folders_refused">The phone will not ask again. Permission to read pictures can be given in this app\'s settings, under Permissions.</string>
    <!-- Button (verb): opens Android's page for this app -->
    <string name="folders_open_app_settings">Open app settings</string>
    <string name="folders_none">There are no pictures on this phone yet.</string>
    <!-- A folder row once held: a second tap hides it from the list -->
    <string name="folders_hide_armed">Hide this folder — tap again</string>
    <!-- Heading over the phone's own folders, shown only when an Immich server is set -->
    <string name="folders_on_phone">On the phone</string>
    <!-- Heading over the albums from the Immich server. Immich is a product name -->
    <string name="folders_immich">Immich</string>
    <string name="immich_asking">Asking Immich for its albums.</string>
    <string name="immich_unreachable">Immich could not be reached. It may be off, or the phone off the network it is on.</string>
    <string name="immich_unreachable_last_seen">Immich could not be reached; these are the albums as they were last seen.</string>
    <string name="immich_refused">Immich did not accept the key. It can be changed in settings.</string>
    <string name="immich_no_albums">There are no albums on Immich with pictures in them.</string>
    <!-- In place of a grid while an album's pictures are being fetched -->
    <string name="immich_reading_album">Reading the album from Immich.</string>
    <!-- Folder name for pictures at the very top of the phone's own storage, which have no folder -->
    <string name="folder_root_phone">Phone</string>
    <!-- Folder name for pictures at the very top of a memory card -->
    <string name="folder_root_card">Card</string>
    <!-- Added after a folder's name when it is on a memory card and another folder has the same name, e.g. "Camera · card" -->
    <string name="folder_on_card">card</string>

    <!-- ============================================================ -->
    <!-- Grid: one folder's pictures -->

    <!-- Back arrow in the top bar, read aloud by a screen reader -->
    <string name="grid_cd_back">Back to folders</string>

    <!-- ============================================================ -->
    <!-- Viewer: one picture on the whole screen -->

    <!-- Top bar title. %1$d is the picture's place in the folder, %2$d how many there are -->
    <string name="viewer_position">%1$d of %2$d</string>
    <!-- Top bar buttons, read aloud by a screen reader -->
    <string name="viewer_cd_back">Back</string>
    <string name="viewer_cd_info">Details</string>
    <string name="viewer_cd_share">Share</string>
    <string name="viewer_cd_delete">Delete</string>
    <!-- Video player -->
    <string name="video_close">Close</string>
    <!-- Buttons that skip back and on by ten seconds -->
    <string name="video_back_ten">−10 s</string>
    <string name="video_on_ten">+10 s</string>
    <!-- Read aloud by a screen reader -->
    <string name="video_cd_play">Play</string>
    <string name="video_cd_pause">Pause</string>
    <string name="video_failed">This video cannot be played on this phone.</string>
    <string name="viewer_failed">This picture could not be opened. It may be in a format this phone cannot read, or no longer there.</string>
    <!-- Toast when nothing on the phone can receive a shared picture -->
    <string name="viewer_no_share">Nothing on this phone can take a picture.</string>

    <!-- Details dialog -->
    <!-- The date the camera recorded -->
    <string name="info_taken">Taken</string>
    <!-- When no camera date is known: the date the file was written, which may be much later -->
    <string name="info_saved">Saved to the phone</string>
    <!-- For a picture on the Immich server with no camera date: only when its file was made, which may be when it was copied -->
    <string name="info_file_date">File date, not when it was taken</string>
    <string name="info_size">Size</string>
    <!-- Width by height in pixels. %1$d width, %2$d height -->
    <string name="info_dimensions">%1$d × %2$d</string>
    <string name="info_folder">Folder</string>
    <!-- A video's running time -->
    <string name="info_length">Length</string>
    <!-- For a picture on the Immich server: the album it was opened from -->
    <string name="info_album">Immich album</string>
    <string name="info_camera">Camera</string>
    <!-- Button (verb) -->
    <!-- Button (verb): opens the picture's folder in the phone's file manager -->
    <string name="info_show_folder">Show in Files</string>
    <string name="info_close">Close</string>

    <!-- ============================================================ -->
    <!-- Choosing pictures for another app, e.g. an attachment in Email -->

    <!-- Top bar title when the other app takes one picture -->
    <string name="pick_title_one">Choose a picture</string>
    <!-- Top bar title when it takes several -->
    <string name="pick_title_several">Choose pictures</string>
    <!-- Close button in the top bar, read aloud by a screen reader: leaves without choosing -->
    <string name="pick_cd_cancel">Cancel</string>
    <!-- Top bar button once pictures are marked. %d is how many; it sends them to the app that asked -->
    <string name="pick_send">Choose %d</string>
    <!-- When the asking app takes only kinds of picture this phone has none of -->
    <string name="pick_none_fit">None of the pictures here are of a kind that app can take.</string>

    <!-- ============================================================ -->
    <!-- Settings screen -->

    <string name="settings_title">Settings</string>
    <!-- Top bar buttons, read aloud by a screen reader -->
    <string name="settings_cd_close">Close</string>
    <string name="settings_cd_about">About</string>
    <string name="settings_folder_order">Folders</string>
    <string name="settings_picture_order">Pictures in a folder</string>
    <string name="settings_per_row">Pictures across a row</string>
    <!-- Order values, shown under the two rows above -->
    <string name="order_newest_first">Newest first</string>
    <string name="order_oldest_first">Oldest first</string>
    <string name="order_name">By name</string>
    <!-- Folders hidden by hand, and the dialog that brings them back -->
    <string name="settings_hidden">Hidden folders</string>
    <plurals name="settings_hidden_count">
        <item quantity="one">%d folder</item>
        <item quantity="other">%d folders</item>
    </plurals>
    <string name="hidden_note">Press one to show it again. Hold a folder in the list to hide it.</string>
    <!-- Immich rows. Immich is a product name; API key is its own term -->
    <string name="settings_immich_server">Immich server</string>
    <string name="settings_immich_key">Immich API key</string>
    <string name="settings_not_set">Not set</string>
    <!-- Value of the key row once a key is saved; the key itself is never shown -->
    <string name="settings_key_set">Set</string>
    <string name="settings_immich_server_note">Its address, as the Immich app has it, starting https://.</string>
    <string name="settings_immich_key_note">Made in Immich under Account settings, API keys. It needs to read albums and assets and to view assets; to back up, also to upload assets.</string>
    <!-- Backing up the camera's pictures to Immich -->
    <string name="settings_backup">Back up the camera to Immich</string>
    <string name="backup_off">Off. Pictures from the camera stay only on the phone.</string>
    <!-- %1$d backed up, %2$d camera pictures on the phone -->
    <string name="backup_some">%1$d of %2$d backed up</string>
    <!-- %1$d camera pictures, all backed up -->
    <string name="backup_all">All %1$d backed up</string>
    <string name="backup_nothing">The camera has no pictures on the phone yet.</string>
    <!-- %1$s is a date and time -->
    <string name="backup_last_run">Last checked %1$s</string>
    <string name="backup_last_unreachable">The last try could not reach Immich; it will try again</string>
    <string name="backup_waiting_wifi_charging">Waiting for Wi-Fi and the charger</string>
    <string name="backup_waiting_wifi">Waiting for Wi-Fi</string>
    <string name="backup_waiting_network">Waiting for a network</string>
    <string name="backup_refused">Immich would not take an upload with this key. It needs permission to upload assets.</string>
    <string name="settings_backup_when">Upload</string>
    <string name="backup_when_wifi_charging">On Wi-Fi, while charging</string>
    <string name="backup_when_wifi">On Wi-Fi</string>
    <string name="backup_when_any">On any network, mobile data too</string>
    <string name="settings_forget_server">Forget the Immich server</string>
    <!-- The same row once pressed: the action, a dash, and "tap again" -->
    <string name="settings_forget_server_armed">Forget the Immich server — tap again</string>
    <string name="settings_forget_server_note">Removes the address, the key and the pictures kept from it, and stops backing up. Nothing on the server changes.</string>
    <!-- Buttons in the entry dialog -->
    <string name="entry_cancel">Cancel</string>
    <string name="entry_save">Save</string>
    <!-- The eye beside the key, read aloud by a screen reader -->
    <string name="entry_show_key">Show the key</string>
    <string name="entry_hide_key">Hide the key</string>

    <!-- ============================================================ -->
    <!-- About dialog. Keep the names of the app, people, projects and licences as they are -->

    <!-- Heading. %1$s is the version number, e.g. 0.1.0 -->
    <string name="about_title">Gallery %1$s</string>
    <string name="about_privacy">It reads the pictures on this phone to show them. With an Immich server set, it also reads your albums from it and, if you turn backing up on, sends the camera\'s pictures to it — to that server only, using the key you gave it.</string>
    <string name="about_after">After Fossify Gallery, GPL 3.0, whose ways of ordering folders and pictures this keeps.</string>
    <!-- The name of the app's licence -->
    <string name="about_licence">GNU General Public License v3</string>
    <string name="about_icons">Icons from Material Symbols, Apache 2.0</string>
    <!-- The donation link label, beside a drawing of a llama. A fixed phrase: a verb and an object, so the reader knows what pressing it does -->
    <string name="about_feed_the_llamas">feed the llamas</string>
    <!-- Toast when the donation link cannot be opened -->
    <string name="about_no_browser">There is no browser on this phone to open that with.</string>
    <!-- Button that closes the About dialog -->
    <string name="about_close">Close</string>
</resources>
