    <string name="about_title">Gallery %1$s</string>
    <string name="about_privacy_head">Privacy</string>
    <string name="about_privacy">Gallery reads the pictures on this phone to show them. It goes online only to the servers you set up (Immich, for its albums; Nextcloud, to show the pictures in your own folders there; and either, to back up the folders you choose) and for Share by tap and Receive by tap, which pass one picture to a phone on the same Wi-Fi and nowhere else. Your sign-in details are kept on this phone. Browsing Nextcloud only reads: it changes and deletes nothing there, and keeps nothing but small copies in the app\'s cache, deleted on signing out. Nothing is sent to the app\'s maker. There are no ads, no analytics and no tracking. Backups and exports go only where you choose to save them.</string>
    <string name="about_terms_head">Terms</string>
    <string name="about_terms">This app is free software under the GNU General Public License v3. It comes with no warranty: use it at your own risk.</string>
    <string name="about_contact">Questions and problems: email@wanderthe.dev</string>
    <string name="about_after">After Fossify Gallery, GPL 3.0, whose ways of ordering folders and pictures this keeps.</string>
    <string name="about_icons">Icons from Material Symbols, Apache 2.0</string>
    <!-- The donation link label, beside a drawing of a llama. A fixed phrase: a verb and an object, so the reader knows what pressing it does -->
    <string name="about_feed_the_llamas">feed the llamas</string>
    <!-- Toast when the donation link cannot be opened -->
