<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Reading pictures, and nothing else. This is the Android 12 permission; the app targets
      the phone's own Android, so the split into READ_MEDIA_IMAGES that came with 13 does not
      apply. Deleting needs no permission of its own: the phone asks the person each time.

      There is no all-files permission, which Fossify asks for to find folders the media index
      does not.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!--
      Only for an Immich server, and only when one has been set: its albums are read from it.
      The app talks to the address given in settings and to nothing else, and plain http is
      refused — the address has to be https.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11 and later hide other apps unless asked for by what they do: Files, to show a
         folder in, and whatever takes a shared picture. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.document/directory" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <!-- No backup: the Immich key is the one thing kept here worth anything, and a copy of it in
         a phone backup is a copy of the key to every picture on the server. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- So a picture opened from Files, Email or Messaging can be shown here. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- A camera's "last photo" thumbnail. Open Camera sends the older spelling first. -->
            <intent-filter>
                <action android:name="com.android.camera.action.REVIEW" />
                <action android:name="android.provider.action.REVIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!--
          Another app asking for a picture: Email attaching one, Messaging sending one. Standard
          launch mode, so the answer goes back to the app that asked. Pictures only, unlike
          Files: a gallery offered in a request for a document would offer nothing.
        -->
        <activity
            android:name=".PickActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App">
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="vnd.android.cursor.dir/image" />
            </intent-filter>
        </activity>

        <!-- Camera (shashinki) saying it has just saved a photo; see NewPictureReceiver. -->
        <receiver
            android:name=".backup.NewPictureReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.wanderwildwood.garo.action.NEW_PICTURE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
