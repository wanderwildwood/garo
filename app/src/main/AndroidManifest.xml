<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Reading pictures, and nothing else. This is the Android 12 permission; the app targets
      the phone's own Android, so the split into READ_MEDIA_IMAGES that came with 13 does not
      apply. Deleting needs no permission of its own: the phone asks the person each time.

      There is no all-files permission, which Fossify asks for to find folders the media index
      does not.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!--
      For the servers set in settings and nothing else: Immich, whose albums are read and which
      can take a backup, and Nextcloud, whose folders are read and which can take a backup. Plain http is refused for both:
      the address has to be https. Share by tap and Receive by tap use it too, for one picture
      over the local Wi-Fi to a private address (see tap/).
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Share by tap: the other phone reads a short link from this one over NFC; Receive by tap
      reads it the other way round. A normal permission, granted at install; nothing is asked.
      Both go over the local Wi-Fi only, to a private address (see tap/Receive.kt).
    -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />

    <!-- Android 11 and later hide other apps unless asked for by what they do: Files, to show a
         folder in, and whatever takes a shared picture. -->
    <queries>
        <!-- Which app opens a picture or a video, for the "Opens pictures and videos" row.
             Without these Android 11 and later would only ever answer "this one". -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.document/directory" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <!-- No backup: the Immich key is the one thing kept here worth anything, and a copy of it in
         a phone backup is a copy of the key to every picture on the server. -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_mudita"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_mudita"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.App">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "The gallery app", for whatever asks for it by kind. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_GALLERY" />
            </intent-filter>

            <!-- So a picture or a video opened from Files, Email or Messaging is shown here. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- A camera's "last photo" thumbnail. Open Camera sends the older spelling first. -->
            <intent-filter>
                <action android:name="com.android.camera.action.REVIEW" />
                <action android:name="android.provider.action.REVIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!--
          Another app asking for a picture: Email attaching one, Messaging sending one. Standard
          launch mode, so the answer goes back to the app that asked. Pictures only, unlike
          Files: a gallery offered in a request for a document would offer nothing.
        -->
        <activity
            android:name=".PickActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App">
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="vnd.android.cursor.dir/image" />
            </intent-filter>
        </activity>

        <!--
          Editing a picture: this app's viewer, and every other app's Edit. Until this, the only
          editor on a Kompakt was the old built-in Gallery's, which Files' share sheet led to.
          Standard launch mode, so the saved picture goes back to the app that asked.
        -->
        <activity
            android:name=".EditActivity"
            android:exported="true"
            android:label="@string/edit_label"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App">
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!--
          The tag the other phone reads. Disabled here; the Share by tap screen switches it on
          while it is showing and off again when it is left (see tap/TapShare.kt).
        -->
        <service
            android:name=".tap.TapTagService"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/tap_apdu_service" />
        </service>

        <!-- A picture from Nextcloud handed to another app to share: a copy in the cache, read
             only by the app it is shared with, for that share. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <!-- Camera (shashinki) saying it has just saved a photo; see NewPictureReceiver. -->
        <receiver
            android:name=".backup.NewPictureReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.wanderwildwood.garo.action.NEW_PICTURE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
